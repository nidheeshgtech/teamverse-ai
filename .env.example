# Copy to .env.local and fill in. Never commit real values.
# Local values are printed by `npx supabase start` (or `npx supabase status`).

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (browser-safe: publishable key + URL; RLS protects data)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key — SERVER ONLY. Bypasses RLS; used only to create the auth user when an
# invitation is accepted. Leave empty to see the honest "not configured" state on invite pages.
SUPABASE_SECRET_KEY=

# Serve the /dev/* preview routes in a production build (CI e2e only). Applied at BUILD time —
# never deploy a build made with this flag.
# ENABLE_DEV_PREVIEW=1

# Later phases (unused so far):
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# AI_PROVIDER=
# AI_API_KEY=
